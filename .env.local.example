# Same Supabase project/database as the ADTECH CMMS — same URL, same anon
# key. This app talks to it exclusively through the `workflow` schema (see
# src/lib/supabase/client.ts and server.ts). Copy this file to .env.local
# and fill in the real values; .env.local is gitignored.
#
# NOTE: until the `workflow` schema is added to Project Settings > API >
# Exposed schemas in the Supabase Dashboard, every query from this app will
# 404 — see Brief 001 §3 and the result doc for this brief.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
